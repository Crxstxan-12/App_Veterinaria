<%- include('partials/head', { titulo: titulo }) %>
<% const puedeEditar = esAdmin(usuario) || usuario.rol === 'recepcion'; %>

<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
  <form class="d-flex search-bar flex-grow-1" action="/tutores" method="get" style="max-width:480px">
    <input class="form-control" type="search" name="q" value="<%= q %>" data-autosubmit
           placeholder="Buscar por nombre, teléfono, documento o correo…">
    <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
  </form>
  <% if (puedeEditar) { %>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTutor" data-fill="#modalTutor">
      <i class="bi bi-person-plus me-1"></i> Nuevo tutor
    </button>
  <% } %>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-people me-2"></i>Tutores registrados</span>
    <span class="badge badge-soft badge-primary"><%= tutores.length %> resultado(s)</span>
  </div>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Tutor</th><th>Contacto</th><th>Documento</th>
          <th class="text-center">Mascotas</th><th class="text-center">Consentimiento</th>
          <% if (puedeEditar) { %><th class="text-end">Acciones</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% if (tutores.length === 0) { %>
          <tr><td colspan="6"><div class="empty-state"><i class="bi bi-person-x"></i>No se encontraron tutores</div></td></tr>
        <% } %>
        <% tutores.forEach(function (t) { %>
          <tr>
            <td>
              <div class="fw-semibold"><%= t.nombre %> <%= t.apellido %></div>
              <% if (t.direccion) { %><div class="text-muted small"><i class="bi bi-geo-alt me-1"></i><%= t.direccion %></div><% } %>
            </td>
            <td>
              <div><i class="bi bi-telephone me-1 text-muted"></i><%= t.telefono %></div>
              <% if (t.email) { %><div class="text-muted small"><i class="bi bi-envelope me-1"></i><%= t.email %></div><% } %>
            </td>
            <td><%= t.documento || '—' %></td>
            <td class="text-center">
              <a href="/mascotas?q=<%= encodeURIComponent(t.nombre + ' ' + t.apellido) %>" class="badge badge-soft badge-info text-decoration-none">
                <%= t.mascotas %>
              </a>
            </td>
            <td class="text-center">
              <% if (t.consentimiento) { %>
                <span class="badge badge-soft badge-ok"><i class="bi bi-check2"></i> Otorgado</span>
              <% } else { %>
                <span class="badge badge-soft badge-warn">Pendiente</span>
              <% } %>
            </td>
            <% if (puedeEditar) { %>
              <td class="text-end text-nowrap">
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalTutor"
                        data-fill="#modalTutor" data-action="/tutores/<%= t.id %>"
                        data-json='<%= JSON.stringify({nombre:t.nombre, apellido:t.apellido, documento:t.documento||"", telefono:t.telefono, email:t.email||"", direccion:t.direccion||"", consentimiento:!!t.consentimiento, notas:t.notas||""}) %>'>
                  <i class="bi bi-pencil"></i>
                </button>
                <% if (esAdmin(usuario)) { %>
                  <form class="d-inline" action="/tutores/<%= t.id %>/eliminar" method="post"
                        data-confirm="¿Eliminar al tutor <%= t.nombre %> <%= t.apellido %>?">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                  </form>
                <% } %>
              </td>
            <% } %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (puedeEditar) { %>
<div class="modal fade" id="modalTutor" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <form action="/tutores" method="post">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-person-vcard me-2"></i>Datos del tutor</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Nombre *</label>
              <input class="form-control" name="nombre" required maxlength="60">
            </div>
            <div class="col-md-6">
              <label class="form-label">Apellido *</label>
              <input class="form-control" name="apellido" required maxlength="60">
            </div>
            <div class="col-md-6">
              <label class="form-label">Documento / RUT</label>
              <input class="form-control" name="documento" maxlength="20">
            </div>
            <div class="col-md-6">
              <label class="form-label">Teléfono *</label>
              <input class="form-control" name="telefono" required placeholder="+56 9 1234 5678" maxlength="25">
            </div>
            <div class="col-md-6">
              <label class="form-label">Correo electrónico</label>
              <input class="form-control" type="email" name="email" maxlength="80">
            </div>
            <div class="col-md-6">
              <label class="form-label">Dirección</label>
              <input class="form-control" name="direccion" maxlength="120">
            </div>
            <div class="col-12">
              <label class="form-label">Notas</label>
              <textarea class="form-control" name="notas" rows="2" maxlength="300"></textarea>
            </div>
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="consentimiento" id="consentimiento" value="1">
                <label class="form-check-label" for="consentimiento">
                  El tutor otorga consentimiento para el tratamiento de datos.
                </label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%- include('partials/foot') %>
