<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Iniciar sesión · VetConecta</title>
  <link href="/static/vendor/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/vendor/css/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/static/css/styles.css" rel="stylesheet">
</head>
<body>
<div class="login-page">
  <div class="card login-card">
    <div class="row g-0">
      <div class="col-lg-6 login-visual">
        <div class="logo-lg"><i class="bi bi-heart-pulse-fill"></i></div>
        <h1>VetConecta</h1>
        <p class="mb-4" style="opacity:.9">Plataforma de registro y gestión de mascotas y sus tutores para clínica veterinaria.</p>
        <div class="feat"><i class="bi bi-check-circle-fill"></i> Fichas y antecedentes siempre disponibles</div>
        <div class="feat"><i class="bi bi-check-circle-fill"></i> Agenda de citas sin duplicidades</div>
        <div class="feat"><i class="bi bi-check-circle-fill"></i> Recordatorios por WhatsApp o correo</div>
        <div class="feat"><i class="bi bi-check-circle-fill"></i> Permisos por rol y respaldos</div>
      </div>

      <div class="col-lg-6 login-form bg-white">
        <h3 class="fw-bold mb-1">Bienvenido/a</h3>
        <p class="text-muted mb-4">Ingrese sus credenciales para continuar.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
          </div>
        <% } %>
        <% if (flash && flash.ok) { %>
          <div class="alert alert-success d-flex align-items-center">
            <i class="bi bi-check-circle-fill me-2"></i><%= flash.ok %>
          </div>
        <% } %>

        <form action="/login" method="post" novalidate>
          <div class="mb-3">
            <label class="form-label fw-semibold">Correo electrónico</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
              <input type="email" name="email" class="form-control" value="<%= email || '' %>"
                     placeholder="usuario@vetconecta.cl" autocomplete="username" required autofocus>
            </div>
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">Contraseña</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
              <input type="password" name="password" id="password" class="form-control"
                     placeholder="••••••••" autocomplete="current-password" required>
              <button class="btn btn-outline-secondary" type="button" id="togglePass" tabindex="-1">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>
          <button class="btn btn-primary w-100 py-2" type="submit">
            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
          </button>
        </form>

        <hr class="my-4">
        <p class="text-muted small mb-2 fw-semibold">Accesos de demostración:</p>
        <ul class="list-unstyled small text-muted mb-0">
          <li><i class="bi bi-person-badge me-1"></i> admin@vetconecta.cl · <code>admin123</code></li>
          <li><i class="bi bi-person-badge me-1"></i> recepcion@vetconecta.cl · <code>recepcion123</code></li>
          <li><i class="bi bi-person-badge me-1"></i> vet@vetconecta.cl · <code>vet123</code></li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script src="/static/vendor/js/bootstrap.bundle.min.js"></script>
<script>
  document.getElementById('togglePass').addEventListener('click', function () {
    const p = document.getElementById('password');
    const icon = this.querySelector('i');
    p.type = p.type === 'password' ? 'text' : 'password';
    icon.className = p.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
  });
</script>
</body>
</html>
