<%- include('partials/head', { titulo: titulo }) %>
<% const puedeEditar = esAdmin(usuario) || usuario.rol === 'recepcion'; %>
<% const icono = (e) => e === 'Gato' ? '🐱' : e === 'Perro' ? '🐶' : e === 'Ave' ? '🐦' : e === 'Conejo' ? '🐰' : '🐾'; %>

<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
  <form class="d-flex gap-2 flex-grow-1" action="/mascotas" method="get" style="max-width:640px">
    <div class="input-group search-bar">
      <input class="form-control" type="search" name="q" value="<%= q %>" data-autosubmit
             placeholder="Buscar por mascota, tutor, teléfono o microchip…">
      <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
    </div>
    <select class="form-select" name="especie" onchange="this.form.submit()" style="max-width:170px">
      <option value="">Todas las especies</option>
      <% ESPECIES.forEach(function (e) { %>
        <option value="<%= e %>" <%= especieF === e ? 'selected' : '' %>><%= e %></option>
      <% }); %>
    </select>
  </form>
  <% if (puedeEditar) { %>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalMascota" data-fill="#modalMascota">
      <i class="bi bi-plus-circle me-1"></i> Nueva mascota
    </button>
  <% } %>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-piggy-bank me-2"></i>Registro de mascotas</span>
    <span class="badge badge-soft badge-primary"><%= mascotas.length %> resultado(s)</span>
  </div>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr><th>Mascota</th><th>Tutor</th><th>Datos</th><th>Microchip</th><th class="text-center">Estado</th><th class="text-end">Acciones</th></tr>
      </thead>
      <tbody>
        <% if (mascotas.length === 0) { %>
          <tr><td colspan="6"><div class="empty-state"><i class="bi bi-search"></i>No se encontraron mascotas</div></td></tr>
        <% } %>
        <% mascotas.forEach(function (m) { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="avatar-pet"><%= icono(m.especie) %></div>
                <div>
                  <a href="/mascotas/<%= m.id %>" class="fw-semibold text-decoration-none"><%= m.nombre %></a>
                  <div class="text-muted small"><%= m.especie %><%= m.raza ? ' · ' + m.raza : '' %></div>
                </div>
              </div>
            </td>
            <td>
              <div><%= m.tutor %></div>
              <div class="text-muted small"><i class="bi bi-telephone me-1"></i><%= m.tutor_telefono %></div>
            </td>
            <td class="small text-muted">
              <div><i class="bi bi-calendar me-1"></i><%= m.edad || 'Edad no registrada' %></div>
              <div><i class="bi bi-gender-ambiguous me-1"></i><%= m.sexo || '—' %><%= m.peso ? ' · ' + m.peso + ' kg' : '' %></div>
            </td>
            <td><span class="chip"><i class="bi bi-upc-scan"></i><%= m.microchip || 'sin registro' %></span></td>
            <td class="text-center">
              <% if (m.estado === 'activo') { %><span class="badge badge-soft badge-ok">Activo</span>
              <% } else if (m.estado === 'fallecido') { %><span class="badge badge-soft badge-muted">Fallecido</span>
              <% } else { %><span class="badge badge-soft badge-info">Egresado</span><% } %>
            </td>
            <td class="text-end text-nowrap">
              <a href="/mascotas/<%= m.id %>" class="btn btn-sm btn-outline-primary" title="Ver ficha"><i class="bi bi-eye"></i></a>
              <% if (puedeEditar) { %>
                <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalMascota"
                        data-fill="#modalMascota" data-action="/mascotas/<%= m.id %>"
                        data-json='<%= JSON.stringify({nombre:m.nombre, especie:m.especie, raza:m.raza||"", sexo:m.sexo||"", color:m.color||"", fecha_nacimiento:m.fecha_nacimiento||"", peso:m.peso==null?"":m.peso, microchip:m.microchip||"", tutor_id:m.tutor_id, estado:m.estado, notas:m.notas||""}) %>'>
                  <i class="bi bi-pencil"></i>
                </button>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (puedeEditar) { %>
<div class="modal fade" id="modalMascota" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <form action="/mascotas" method="post">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-piggy-bank me-2"></i>Ficha de la mascota</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Nombre *</label>
              <input class="form-control" name="nombre" required maxlength="60">
            </div>
            <div class="col-md-6">
              <label class="form-label">Tutor responsable *</label>
              <select class="form-select" name="tutor_id" required>
                <option value="">Seleccione…</option>
                <% tutores.forEach(function (t) { %>
                  <option value="<%= t.id %>"><%= t.nombre %> <%= t.apellido %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Especie *</label>
              <select class="form-select" name="especie" required>
                <% ESPECIES.forEach(function (e) { %><option value="<%= e %>"><%= e %></option><% }); %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Raza</label>
              <input class="form-control" name="raza" maxlength="60">
            </div>
            <div class="col-md-4">
              <label class="form-label">Sexo</label>
              <select class="form-select" name="sexo">
                <option value="">Seleccione…</option>
                <option>Macho</option><option>Hembra</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Color / señas</label>
              <input class="form-control" name="color" maxlength="60">
            </div>
            <div class="col-md-4">
              <label class="form-label">Fecha de nacimiento</label>
              <input class="form-control" type="date" name="fecha_nacimiento">
            </div>
            <div class="col-md-4">
              <label class="form-label">Peso (kg)</label>
              <input class="form-control" type="number" step="0.01" min="0" name="peso">
            </div>
            <div class="col-md-6">
              <label class="form-label">Microchip</label>
              <input class="form-control" name="microchip" maxlength="40">
            </div>
            <div class="col-md-6">
              <label class="form-label">Estado</label>
              <select class="form-select" name="estado">
                <option value="activo">Activo</option>
                <option value="egresado">Egresado</option>
                <option value="fallecido">Fallecido</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label">Notas / antecedentes generales</label>
              <textarea class="form-control" name="notas" rows="2" maxlength="400"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%- include('partials/foot') %>
