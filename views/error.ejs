<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · VetConecta</title>
  <link href="/static/vendor/css/bootstrap.min.css" rel="stylesheet">
  <link href="/static/vendor/css/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/static/css/styles.css" rel="stylesheet">
</head>
<body>
<div class="login-page">
  <div class="card login-card p-5 text-center bg-white" style="max-width:560px">
    <div class="display-1 fw-bold" style="color:var(--vc-primary-dark)"><%= codigo %></div>
    <h3 class="fw-bold mt-2"><%= titulo %></h3>
    <p class="text-muted"><%= mensaje %></p>
    <div class="d-flex gap-2 justify-content-center mt-3">
      <a href="/panel" class="btn btn-primary"><i class="bi bi-house me-1"></i> Ir al panel</a>
      <button class="btn btn-outline-secondary" onclick="history.back()"><i class="bi bi-arrow-left me-1"></i> Volver</button>
    </div>
  </div>
</div>
</body>
</html>
