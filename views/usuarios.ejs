<%- include('partials/head', { titulo: titulo }) %>

<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
  <div class="text-muted small">
    <i class="bi bi-shield-lock me-1"></i>Gestión de accesos y permisos por rol.
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalUsuario" data-fill="#modalUsuario">
    <i class="bi bi-person-plus me-1"></i> Nuevo usuario
  </button>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Usuario</th><th>Rol</th><th>Teléfono</th><th class="text-center">Estado</th><th class="text-end">Acciones</th></tr></thead>
      <tbody>
        <% usuarios.forEach(function (u) { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-3">
                <div class="avatar-pet" style="<%= u.rol === 'superusuario' ? 'background:#fef3c7;color:#b45309' : u.rol === 'administrador' ? 'background:#ede9fe;color:#6d28d9' : u.rol === 'veterinario' ? 'background:#dbeafe;color:#1d4ed8' : 'background:#dcfce7;color:#15803d' %>">
                  <i class="bi <%= u.rol === 'superusuario' ? 'bi-shield-fill-check' : u.rol === 'administrador' ? 'bi-shield-check' : u.rol === 'veterinario' ? 'bi-clipboard2-pulse' : 'bi-headset' %>"></i>
                </div>
                <div>
                  <div class="fw-semibold"><%= u.nombre %> <% if (u.id === usuario.id) { %><span class="badge badge-soft badge-info">yo</span><% } %></div>
                  <div class="text-muted small"><%= u.email %></div>
                </div>
              </div>
            </td>
            <td><span class="badge badge-soft badge-primary"><%= etiquetaRol(u.rol) %></span></td>
            <td><%= u.telefono || '—' %></td>
            <td class="text-center">
              <% if (u.activo) { %><span class="badge badge-soft badge-ok">Activo</span>
              <% } else { %><span class="badge badge-soft badge-muted">Inactivo</span><% } %>
            </td>
            <td class="text-end text-nowrap">
              <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalUsuario"
                      data-fill="#modalUsuario" data-action="/usuarios/<%= u.id %>"
                      data-json='<%= JSON.stringify({nombre:u.nombre, email:u.email, rol:u.rol, telefono:u.telefono||"", activo:!!u.activo}) %>'>
                <i class="bi bi-pencil"></i>
              </button>
              <% if (u.id !== usuario.id) { %>
                <form class="d-inline" action="/usuarios/<%= u.id %>/eliminar" method="post"
                      data-confirm="¿Eliminar al usuario <%= u.nombre %>?">
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header"><i class="bi bi-info-circle me-2"></i>Matriz de permisos</div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Función</th><th class="text-center">Superusuario</th><th class="text-center">Administrador</th><th class="text-center">Recepción</th><th class="text-center">Veterinario</th></tr></thead>
      <tbody>
        <% const filas = [
          ['Ver panel y búsqueda', true, true, true, true],
          ['Gestionar tutores y mascotas', true, true, true, false],
          ['Registrar antecedentes clínicos', true, true, false, true],
          ['Administrar agenda y recordatorios', true, true, true, true],
          ['Gestionar usuarios y configuración', true, true, false, false],
        ]; %>
        <% filas.forEach(function (f) { %>
          <tr>
            <td><%= f[0] %></td>
            <% [1,2,3,4].forEach(function (i) { %>
              <td class="text-center">
                <% if (f[i]) { %><i class="bi bi-check-circle-fill text-success"></i>
                <% } else { %><i class="bi bi-dash-circle text-muted"></i><% } %>
              </td>
            <% }); %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="modalUsuario" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/usuarios" method="post">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-person-vcard me-2"></i>Datos del usuario</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Nombre *</label><input class="form-control" name="nombre" required maxlength="80"></div>
            <div class="col-md-6"><label class="form-label">Teléfono</label><input class="form-control" name="telefono" maxlength="25"></div>
            <div class="col-md-6"><label class="form-label">Correo *</label><input class="form-control" type="email" name="email" required maxlength="80"></div>
            <div class="col-md-6">
              <label class="form-label">Rol *</label>
              <select class="form-select" name="rol" required>
                <% ROLES.forEach(function (r) { %><option value="<%= r %>"><%= etiquetaRol(r) %></option><% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Contraseña</label>
              <input class="form-control" type="text" name="password" minlength="6" placeholder="Mínimo 6 caracteres">
            </div>
            <div class="col-md-6 d-flex align-items-end">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="activo" id="activo" value="1" checked>
                <label class="form-check-label" for="activo">Cuenta activa</label>
              </div>
            </div>
          </div>
          <div class="alert alert-light border mt-3 mb-0 small">
            <i class="bi bi-info-circle me-1"></i>Al crear un usuario la contraseña es obligatoria. Al editar, déjela vacía para conservar la actual.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
